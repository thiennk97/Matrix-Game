    "@lucide/vue": "latest",
    "@pinia/nuxt": "latest",
    "@types/three": "^0.187.0",
    "nuxt": "latest",
    "pinia": "latest",
    "pixi.js": "^7.4.2",
    "socket.io-client": "latest",
    "three": "^0.187.0",
    "typescript": "^5.6.3",
    "vue": "latest",
    "vue-router": "latest"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "eslint": "^10.8.1",
    "postcss": "^8.5.26",
    "vue-tsc": "^3.3.9"
  }
}
