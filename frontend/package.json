{
  "name": "frontend",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "build:frontend": "nuxt generate && mkdir -p ../public && rm -rf ../public/* && cp -r .output/public/* ../public/",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --fix"
  },
  "dependencies": {
